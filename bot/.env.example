# --- Order pipeline (docs/ORDER_PIPELINE.md) ---
PIPELINE_ENABLED=true
# Reminders/follow-ups/NP tracking run where Telegram polling runs; override explicitly if needed
PIPELINE_SCHEDULER_ENABLED=
# Telegram numeric id of the second contact (gets reminders from level 2 = 15 min).
# Optional: if empty, the user from SECOND_CONTACT_USERNAMES is registered when he presses /start (same for the owner).
SECOND_CONTACT_CHAT_ID=
OWNER_USERNAMES=OficeITHelp
SECOND_CONTACT_USERNAMES=uniwar
REMINDER_MINUTES=5,15,60
WORK_HOURS=09:00-19:00
# 0=Mon ... 6=Sun
WORK_DAYS=0,1,2,3,4,5
BUSINESS_TIMEZONE=Europe/Kyiv
FOLLOWUP_HOURS=24
SHIP_CUTOFF=13:00
REPLY_ETA_TEXT=протягом 5–10 хвилин
PIPELINE_LINK_SECRET=
PIPELINE_CAPTURE_BEFORE_TERMS=true
# Optional overrides of client FAQ texts (HTML allowed)
FAQ_PAYMENT_TEXT=
FAQ_DELIVERY_TEXT=
FAQ_WARRANTY_TEXT=
# Without the key Nova Poshta tracking is simply not scheduled
NOVA_POSHTA_API_KEY=
YUGTORG_API_KEY=
# Telegram Business: bot connected to the owner's personal account (setup: docs/ORDER_PIPELINE.md)
BUSINESS_ENABLED=true
BUSINESS_AUTOREPLY_ENABLED=true
# default: "Отримав, відповім протягом 5–10 хвилин." (outside working hours: "…завтра після 09:00.")
BUSINESS_AUTOREPLY_TEXT=
BUSINESS_IGNORE_CHAT_IDS=
# --- AI consultant "помічник ALT-CAM" (docs/AI_CONSULTANT.md) ---
# One consultant for the site chat widget, the Telegram bot and Telegram Business chats.
# Off unless AI_CONSULTANT_ENABLED=true AND GEMINI_API_KEY is set (LLM_API_KEY is accepted as an alias).
AI_CONSULTANT_ENABLED=false
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
AI_WEB_CHAT_ENABLED=true
AI_WEB_RATE_PER_MINUTE=6
AI_BUSINESS_ENABLED=true
AI_DISCLOSE_BOT=false
AI_COUNTS_AS_RESPONSE=true
AI_PAUSE_ON_OWNER_REPLY=true
AI_MIN_INTERVAL_SECONDS=4
AI_DAILY_REQUEST_LIMIT=200
SUPPLIER_STOCK_TTL_MINUTES=30
NP_TRACKING_INTERVAL_MINUTES=120
